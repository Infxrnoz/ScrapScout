{
    "name": "scrapscout",
    "productName": "ScrapScout",
    "version": "1.2.0",
    "private": true,
    "description": "Free Rust+ companion for your desktop: live map, team, alerts, server browser, ore maps, raid and base tools.",
    "main": "desktop/main.js",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "node server.js",
        "register": "node scripts/register.js",
        "build-data": "node scripts/build-data.js",
        "import-rustplusplus": "node scripts/import-rustplusplus.js",
        "package": "node scripts/package.js",
        "app": "electron .",
        "dist": "electron-builder --win nsis --publish never",
        "dist:personal": "electron-builder --win nsis -c.extraMetadata.scrapscout.importOldVersion=true -c.win.artifactName=ScrapScout-Setup-${version}-personal.${ext}",
        "icon": "node desktop/make-icon.js",
        "gamma": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe -nologo -optimize -target:exe -platform:x64 -r:System.Windows.Forms.dll -out:desktop\\gamma\\gamma.exe desktop\\gamma\\gamma.cs desktop\\gamma\\display.cs",
        "release": "node scripts/release.js"
    },
    "dependencies": {
        "@liamcottle/push-receiver": "^0.0.4",
        "@liamcottle/rustplus.js": "file:vendor/liamcottle-rustplus.js-2.5.0.tgz",
        "chrome-launcher": "^0.15.2",
        "electron-updater": "^6.8.9",
        "express": "^4.21.2",
        "leaflet": "^1.9.4",
        "qrcode": "^1.5.4",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "electron": "^44.6.0",
        "electron-builder": "^26.15.3"
    },
    "overrides": {
        "protobufjs": "7.6.6",
        "request-promise": "file:vendor/request-promise-fetch",
        "request": "file:vendor/empty-request",
        "uuid": "11.1.1"
    },
    "build": {
        "appId": "com.scrapscout.app",
        "productName": "ScrapScout",
        "copyright": "Free tool. Not affiliated with or endorsed by Facepunch Studios.",
        "directories": {
            "output": "dist-app"
        },
        "files": [
            "package.json",
            "server.js",
            "src/**",
            "public/**",
            "desktop/**",
            "!desktop/make-icon.js",
            "!desktop/gamma/**",
            "data/items.json",
            "data/raid.json",
            "data/game.json",
            "data/ores.json",
            "data/spawns.json",
            "data/facilities.json",
            "data/craft-yields.json",
            "data/monuments.json",
            "data/cctv.json"
        ],
        "win": {
            "target": "nsis",
            "icon": "desktop/icon.png",
            "artifactName": "ScrapScout-Setup-${version}.${ext}"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "runAfterFinish": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "ScrapScout",
            "deleteAppDataOnUninstall": false
        },
        "extraResources": [
            {
                "from": "desktop/gamma/gamma.exe",
                "to": "gamma.exe"
            }
        ],
        "publish": [
            {
                "provider": "github",
                "owner": "Infxrnoz",
                "repo": "ScrapScout",
                "releaseType": "release"
            }
        ]
    },
    "license": "PolyForm-Noncommercial-1.0.0"
}
